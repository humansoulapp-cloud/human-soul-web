# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses all RLS: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it to
# /api/cron/publish-journeys; without it that route refuses every request.
CRON_SECRET=

# PostHog product analytics (Project API key, starts with phc_). Region: eu (default) or us.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=eu
# Stripe (test keys start with sk_test_ / pk_test_). NEXT_PUBLIC_PAYWALL=on turns on paid access.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYWALL=
